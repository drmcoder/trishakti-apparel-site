# Copy to .env.local and fill in. .env.local is gitignored (never committed).

# Inquiry form submission endpoint. The site defaults to Web3Forms when this is empty.
# Set this only when using a compatible custom endpoint or Formspree endpoint.
#
#   Web3Forms:  https://api.web3forms.com/submit
#   Formspree:  https://formspree.io/f/xxxxxx
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional public Web3Forms key. Overrides the key configured in the source for
# this deployment. Web3Forms access keys are designed to be present in client code.
NEXT_PUBLIC_WEB3FORMS_KEY=
